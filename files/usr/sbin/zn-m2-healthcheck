#!/bin/sh

PATH="${ZN_M2_PATH:-/usr/sbin:/usr/bin:/sbin:/bin}"

TAG="zn-m2-healthcheck"
STATE_DIR="${STATE_DIR:-/tmp/zn-m2-healthcheck}"
STATE_OWNER="${STATE_OWNER:-root:root}"
INIT_DIR="${INIT_DIR:-/etc/init.d}"
DNSMASQ_CONFIG_GLOB="${DNSMASQ_CONFIG_GLOB:-/var/etc/dnsmasq.conf.*}"
PROC_NET_UDP="${PROC_NET_UDP:-/proc/net/udp}"
PROC_NET_UDP6="${PROC_NET_UDP6:-/proc/net/udp6}"
MIN_MEM_KB="${MIN_MEM_KB:-32768}"
COOLDOWN_SEC="${COOLDOWN_SEC:-600}"

umask 077
if [ -L "$STATE_DIR" ] || { [ -e "$STATE_DIR" ] && [ ! -d "$STATE_DIR" ]; }; then
	rm -rf "$STATE_DIR"
fi
mkdir -p "$STATE_DIR" || exit 1
chown "$STATE_OWNER" "$STATE_DIR" 2>/dev/null || exit 1
chmod 0700 "$STATE_DIR" || exit 1

log() {
	logger -t "$TAG" "$*"
	[ -t 1 ] && printf '%s\n' "$*"
}

cooldown_elapsed() {
	name="$1"
	now="$(date +%s 2>/dev/null || echo 0)"
	case "$now" in
		''|*[!0-9]*) now=0 ;;
	esac
	# Without a sane clock the cooldown cannot be evaluated. Deny the restart
	# instead of allowing an unthrottled restart loop on every cron run.
	[ "$now" -gt 0 ] || return 1
	file="${STATE_DIR}/${name}.last"
	if [ -L "$file" ] || { [ -e "$file" ] && [ ! -f "$file" ]; }; then
		rm -f "$file"
	fi
	last="$(cat "$file" 2>/dev/null || echo 0)"
	case "$last" in
		''|*[!0-9]*) last=0 ;;
	esac

	if [ $((now - last)) -ge "$COOLDOWN_SEC" ]; then
		tmp="${file}.tmp.$$"
		printf '%s\n' "$now" > "$tmp" || return 1
		mv -f "$tmp" "$file" || {
			rm -f "$tmp"
			return 1
		}
		return 0
	fi

	return 1
}

restart_service() {
	service="$1"

	[ -x "${INIT_DIR}/${service}" ] || return 1
	cooldown_elapsed "$service" || return 1
	log "restart ${service}"
	if "${INIT_DIR}/${service}" restart >/dev/null 2>&1; then
		return 0
	fi
	log "restart ${service} failed"
	return 2
}

has_default_route() {
	ip route show default 2>/dev/null | grep -q .
}

check_memory() {
	mem_available="$(awk '/MemAvailable/ {print $2; exit}' /proc/meminfo 2>/dev/null)"

	if [ -n "$mem_available" ] && [ "$mem_available" -lt "$MIN_MEM_KB" ]; then
		log "low memory: ${mem_available}KB available"
	fi
}

check_dns() {
	local_domain="$(uci -q get dhcp.@dnsmasq[0].domain 2>/dev/null || echo lan)"
	hostname="$(uci -q get system.@system[0].hostname 2>/dev/null || hostname 2>/dev/null || echo OpenWrt)"
	local_ok=0
	remote_failed=0

	for host in "${hostname}.${local_domain}" localhost; do
		if ! nslookup "$host" 127.0.0.1 >/dev/null 2>&1; then
			log "local dns lookup failed: ${host}"
		else
			local_ok=1
		fi
	done

	if [ "$local_ok" -eq 0 ]; then
		restart_service dnsmasq
		return
	fi

	for host in www.baidu.com openwrt.org; do
		if ! nslookup "$host" 127.0.0.1 >/dev/null 2>&1; then
			log "remote dns lookup warning: ${host}"
			remote_failed=1
		fi
	done

	[ "$remote_failed" -eq 0 ] || return 0
}

dhcp_runtime_healthy() {
	range_found=0
	for config in $DNSMASQ_CONFIG_GLOB; do
		[ -f "$config" ] || continue
		if grep -Eq '^[[:space:]]*dhcp-range=' "$config"; then
			range_found=1
			break
		fi
	done
	[ "$range_found" -eq 1 ] || return 1

	for proc_file in "$PROC_NET_UDP" "$PROC_NET_UDP6"; do
		[ -r "$proc_file" ] || continue
		if grep -Eq '^[[:space:]]*[0-9]+:[[:space:]]*[0-9A-Fa-f]+:0043[[:space:]]' "$proc_file"; then
			return 0
		fi
	done

	return 1
}

check_dhcp() {
	dhcp_ignore="$(uci -q get dhcp.lan.ignore 2>/dev/null || echo 0)"
	dhcpv4="$(uci -q get dhcp.lan.dhcpv4 2>/dev/null || echo server)"
	[ "$dhcp_ignore" = "1" ] && return 0
	[ "$dhcpv4" = "disabled" ] && return 0

	if dhcp_runtime_healthy; then
		return 0
	fi

	log "lan dhcp runtime unavailable"
	restart_service dnsmasq
	restart_status="$?"
	if [ "$restart_status" -eq 0 ]; then
		if dhcp_runtime_healthy; then
			log "lan dhcp recovered"
		else
			log "lan dhcp remains unavailable after dnsmasq restart"
		fi
	elif [ "$restart_status" -eq 1 ]; then
		log "lan dhcp restart suppressed by cooldown"
	else
		log "lan dhcp restart failed"
	fi
}

check_proxy() {
	if [ ! -x "${INIT_DIR}/homeproxy" ] ||
	   ! "${INIT_DIR}/homeproxy" enabled >/dev/null 2>&1; then
		return 0
	fi

	routing_mode="$(uci -q get homeproxy.config.routing_mode 2>/dev/null || echo bypass_mainland_china)"
	if [ "$routing_mode" = "custom" ]; then
		outbound_node="$(uci -q get homeproxy.routing.default_outbound 2>/dev/null || echo nil)"
	else
		outbound_node="$(uci -q get homeproxy.config.main_node 2>/dev/null || echo nil)"
	fi
	server_enabled="$(uci -q get homeproxy.server.enabled 2>/dev/null || echo 0)"
	if [ -z "$outbound_node" ] || [ "$outbound_node" = "nil" ]; then
		[ "$server_enabled" = "1" ] || return 0
	fi

	if ! pidof sing-box >/dev/null 2>&1; then
		log "homeproxy is enabled but sing-box is not running"
		restart_service homeproxy
	fi
}

check_memory
check_dhcp

if [ "${1:-}" = "--dhcp-only" ]; then
	exit 0
fi

if has_default_route; then
	check_dns
	check_proxy
fi

exit 0
