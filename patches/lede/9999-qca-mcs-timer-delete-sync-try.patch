@@ -21,6 +21,20 @@
 #include <linux/netfilter_bridge.h>
 #include <br_private.h>
 
+/* Linux 6.16 removed three timer symbols that qca-mcs still uses:
+ *   try_to_del_timer_sync() -> timer_delete_sync_try()
+ *   del_timer_sync()        -> timer_delete_sync()
+ *   from_timer()            -> timer_container_of()
+ * qca-mcs is frozen at 2023-04-21, so map the old names forward. The newer
+ * kernels kept identical semantics for the first two, and from_timer() became
+ * a container_of() wrapper over the timer field.
+ */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 16, 0))
+#define try_to_del_timer_sync(timer) timer_delete_sync_try(timer)
+#define del_timer_sync(timer) timer_delete_sync(timer)
+#define from_timer(var, callback_timer, field) timer_container_of(var, callback_timer, field)
+#endif
+
