# The *_COMMIT values below are the offline fallback used when a remote is
# unreachable; scripts/resolve-latest-upstreams.sh replaces every tracked key
# with the current tip of its *_TRACK ref on each build. This is an experimental
# profile, so a pin bump still deserves a look at the resolved diff.
# AURORA_COMMIT is an explicit pin: the theme has no automatic tracking, because
# upstream commits land on master without a release tag and an app-breaking
# theme change must not reach a build unreviewed.
OPENWRT_COMMIT=f9b0ce7650fdcc7f4793256a3ae43c1132e2bc49
INIT_SCRIPT_COMMIT=04a39ca00d2cd6895c84e1c0670bc719cbd8d9fb
INIT_SCRIPT_SHA256=85f4b2c2aa16f8178b57250f5d2bcf4a2e0707c6b569a3b07510f41fc6185dd8
FEED_PACKAGES_COMMIT=decf94639ffd6ddd26591c190b547c6b7eea150b
FEED_LUCI_COMMIT=ad75cde88e694b511100576bfbe0a280e5efe6ef
FEED_ROUTING_COMMIT=ea8633da9c461a9bdc62a0323439d31180762e03
FEED_TELEPHONY_COMMIT=9bcb6d71db03377ff49ccb099be763add9a5b059
FEED_VIDEO_COMMIT=92f51f0f3fffa718fc9d3717a5e852e8ddb2b1e7
VIKINGYFY_COMMIT=1b37de54c02ccdcbf2a880798605f0f20c0de9ef
AURORA_TAG=v1.4.0
AURORA_COMMIT=298dbcc74ddf820923a51285fb0826d429e5d7ca

# Tracked upstream refs. scripts/resolve-latest-upstreams.sh replaces the
# matching *_COMMIT values with the current tip of these refs at build time.
OPENWRT_TRACK=https://github.com/VIKINGYFY/immortalwrt.git#refs/heads/main
FEED_PACKAGES_TRACK=https://github.com/immortalwrt/packages.git#refs/heads/master
FEED_LUCI_TRACK=https://github.com/immortalwrt/luci.git#refs/heads/master
FEED_ROUTING_TRACK=https://github.com/openwrt/routing.git#refs/heads/master
FEED_TELEPHONY_TRACK=https://github.com/openwrt/telephony.git#refs/heads/master
FEED_VIDEO_TRACK=https://github.com/openwrt/video.git#refs/heads/master
VIKINGYFY_TRACK=https://github.com/VIKINGYFY/packages.git#refs/heads/main
