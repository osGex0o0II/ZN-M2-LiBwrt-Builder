# The *_COMMIT values below are the offline fallback used when a remote is
# unreachable; scripts/resolve-latest-upstreams.sh replaces every tracked key
# with the current tip of its *_TRACK ref on each build. This is an experimental
# profile, so a pin bump still deserves a look at the resolved diff.
OPENWRT_COMMIT=80122feac964889bc69b62420cedfefaaf701eb0
FEED_PACKAGES_COMMIT=a25f30bbfcdd3cc130dc7dc5c35b9ed54e0155e8
FEED_LUCI_COMMIT=f0a01674297d51b4bf7cd475a80a962b6f1b67b8
FEED_ROUTING_COMMIT=2d0f967bd6bd95d4c0d3c330e4713e79d75b4c54
FEED_TELEPHONY_COMMIT=d3bcb153813b1ff34b3dd0f1bf0dc913984f2921
# LEDE pins the video feed to its own fork (coolsnowwolf/video), not to
# openwrt/video, so the tracked ref has to use that repository.
FEED_VIDEO_COMMIT=a1c0945bdd677b6c1da20724e555e97861445bce
# helloworld's default branch is `dev`; `master` is an old snapshot that lags
# the active line by hundreds of commits.
FEED_HELLOWORLD_COMMIT=31b180df838e456bb36036bb8791f569af0fd661
VIKINGYFY_COMMIT=1b37de54c02ccdcbf2a880798605f0f20c0de9ef
AURORA_TAG=v1.4.0
AURORA_COMMIT=298dbcc74ddf820923a51285fb0826d429e5d7ca

# Tracked upstream refs. scripts/resolve-latest-upstreams.sh replaces the
# matching *_COMMIT values with the current tip of these refs at build time.
# coolsnwolf/routing publishes only a `main` branch, which upstream has not
# moved since 2026-09-11, so it stays a fixed pin.
OPENWRT_TRACK=https://github.com/coolsnowwolf/lede.git#refs/heads/master
FEED_PACKAGES_TRACK=https://github.com/coolsnowwolf/packages.git#refs/heads/master
FEED_LUCI_TRACK=https://github.com/coolsnowwolf/luci.git#refs/heads/openwrt-25.12
FEED_TELEPHONY_TRACK=https://github.com/coolsnowwolf/telephony.git#refs/heads/master
FEED_VIDEO_TRACK=https://github.com/coolsnowwolf/video.git#refs/heads/master
FEED_HELLOWORLD_TRACK=https://github.com/fw876/helloworld.git#refs/heads/dev
VIKINGYFY_TRACK=https://github.com/VIKINGYFY/packages.git#refs/heads/main
