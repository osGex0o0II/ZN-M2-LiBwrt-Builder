# The *_COMMIT values below are the offline fallback used when a remote is
# unreachable; scripts/resolve-latest-upstreams.sh replaces every tracked key
# with the current tip of its *_TRACK ref on each build.
# AURORA_COMMIT is an explicit pin: the theme has no automatic tracking, because
# upstream commits land on master without a release tag and an app-breaking
# theme change must not reach a build unreviewed.
OPENWRT_COMMIT=6c363ced06ee6dc0c49092a8da087e1dc45f17c9
INIT_SCRIPT_COMMIT=510a0aa7e69b6346027a33300185555780bce502
INIT_SCRIPT_SHA256=2b2795f9110c675c6eb6b4f1c9b980c3a7294834d06ce3a9819f72df4f890bae
FEED_NSS_PACKAGES_COMMIT=0d970dbf0185e3f53709bd803e8a466598023c57
FEED_SQM_SCRIPTS_NSS_COMMIT=4b4ed8639229be5e70cf94b73cdf7dbc09e66d5d
FEED_PACKAGES_COMMIT=fa25995d74a720c1c98bf6265d3dd8b4eb620d1f
FEED_LUCI_COMMIT=8f18275bb510818c501e4b124f872b6d30573d8a
FEED_ROUTING_COMMIT=625f9d8446807708bab4eef26cdc44692164818a
FEED_TELEPHONY_COMMIT=c58ec5a6703966dcccb53d0919698c8aba3a9ef5
FEED_VIDEO_COMMIT=094bf58da6682f895255a35a84349a79dab4bf95
VIKINGYFY_COMMIT=1b37de54c02ccdcbf2a880798605f0f20c0de9ef
AURORA_TAG=v1.4.0
AURORA_COMMIT=298dbcc74ddf820923a51285fb0826d429e5d7ca

# Tracked upstream refs. scripts/resolve-latest-upstreams.sh replaces the
# matching *_COMMIT values with the current tip of these refs at build time, so
# every build uses the latest upstream state of the stable 25.12 line.
OPENWRT_TRACK=https://github.com/LiBwrt/LibWrt.git#refs/heads/25.12-nss
FEED_NSS_PACKAGES_TRACK=https://github.com/qosmio/nss-packages.git#refs/heads/NSS-12.5-K6.x
FEED_SQM_SCRIPTS_NSS_TRACK=https://github.com/qosmio/sqm-scripts-nss.git#refs/heads/main
FEED_PACKAGES_TRACK=https://github.com/immortalwrt/packages.git#refs/heads/openwrt-25.12
FEED_LUCI_TRACK=https://github.com/immortalwrt/luci.git#refs/heads/openwrt-25.12
FEED_ROUTING_TRACK=https://github.com/openwrt/routing.git#refs/heads/openwrt-25.12
FEED_TELEPHONY_TRACK=https://github.com/openwrt/telephony.git#refs/heads/openwrt-25.12
FEED_VIDEO_TRACK=https://github.com/openwrt/video.git#refs/heads/openwrt-25.12
# HomeProxy and sing-box come from this feed, so it must track as well or the
# proxy stack silently stays on an older revision.
VIKINGYFY_TRACK=https://github.com/VIKINGYFY/packages.git#refs/heads/main
