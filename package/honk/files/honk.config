config honk 'config'
	option config_file '/etc/honk/config.dae'
	# 'db' keeps the configuration in a database in data_dir (honk-core --store db).
	# This image uses 'file' to keep the resident set small; doona still edits it.
	option store 'file'
	# Must equal global.data_dir of the configuration; sysupgrade keeps this directory.
	option data_dir '/etc/honk/data'
