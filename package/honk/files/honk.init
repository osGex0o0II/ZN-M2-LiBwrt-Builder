#!/bin/sh /etc/rc.common
#
# procd init script for honk-core.
#
# START/STOP must stay near the top: rpcd's rc list only reads them there.
USE_PROCD=1
START=99
STOP=01

CONF=honk
PROG=/usr/bin/honk-core

start_service() {
	config_load "$CONF"

	local config_file store data_dir
	config_get config_file config config_file /etc/honk/config.dae
	config_get store config store file
	config_get data_dir config data_dir /etc/honk/data

	# dae creates the same dae0/daens pair and hooks the same interfaces.
	if ubus call service list '{"name":"dae"}' 2>/dev/null |
		jsonfilter -q -e '@.dae.instances[*].running' | grep -q true; then
		logger -t honk "dae is running; stop it before starting honk"
		return 1
	fi

	if [ ! -r "$config_file" ]; then
		logger -t honk "cannot read $config_file"
		return 1
	fi

	# honk loads an embedded eBPF object with CO-RE relocations. Without BTF
	# every load fails, so stop here with a message that names the build knob.
	if [ ! -e /sys/kernel/btf/vmlinux ] && [ ! -e /usr/lib/debug/boot/vmlinux ]; then
		logger -t honk "kernel has no BTF; rebuild it with CONFIG_KERNEL_DEBUG_INFO_BTF"
		return 1
	fi

	# aya pins maps under /sys/fs/bpf, which OpenWrt does not mount itself.
	# BusyBox has no mountpoint applet, so check /proc/mounts instead.
	grep -qs ' /sys/fs/bpf bpf ' /proc/mounts || mount -t bpf bpf /sys/fs/bpf

	# procd puts each instance in its own cgroup but enables no controller
	# there, so honk would find no memory.current for its telemetry.
	local cg
	if grep -qsw memory /sys/fs/cgroup/cgroup.controllers; then
		mkdir -p "/sys/fs/cgroup/services/$CONF"
		for cg in /sys/fs/cgroup /sys/fs/cgroup/services "/sys/fs/cgroup/services/$CONF"; do
			echo +memory > "$cg/cgroup.subtree_control" ||
				logger -t honk "cannot enable the memory controller in $cg"
		done
	fi

	procd_open_instance "$CONF"
	procd_set_param command "$PROG" --config "$config_file"
	[ "$store" = db ] && procd_append_param command --store db --data-dir "$data_dir"
	# honk sizes its flow budget from RLIMIT_NOFILE.
	procd_set_param limits core="unlimited" nofile="1048576 1048576"
	# A fatal exit is expected here: upstream issue #476 kills the process at
	# the end of a configuration reload. procd brings it back in a few seconds.
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	config_load "$CONF"

	local config_file store data_dir want
	config_get config_file config config_file /etc/honk/config.dae
	config_get store config store file
	config_get data_dir config data_dir /etc/honk/data

	procd_running "$CONF" "$CONF" || return 0

	# --store and --data-dir are command-line flags, so SIGHUP cannot change
	# them. Compare the running command and fall back to a restart when they
	# differ from the UCI configuration.
	want="$PROG
--config
$config_file"
	[ "$store" = db ] && want="$want
--store
db
--data-dir
$data_dir"

	if [ "$(ubus call service list "{\"name\":\"$CONF\"}" 2>/dev/null |
		jsonfilter -q -e "@.$CONF.instances.$CONF.command[*]")" = "$want" ]; then
		# Reads the instance lock, so a stale instance is reported instead of
		# signalling an unrelated PID.
		"$PROG" reload
	else
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
