# Configuration for honk-core, installed as /etc/honk/config.dae.
#
# This file is a working skeleton: add nodes or subscriptions and routing rules
# in doona before enabling proxy traffic. Until then every connection is routed
# directly, so enabling the service never breaks connectivity.
#
# Interfaces: br-lan is the OpenWrt LAN bridge on this device; `auto` follows
# the interface of the IPv4 default route.
#
# Open http://<router LAN IP>:9527/ from the LAN. Use the IP address: honk
# refuses host names such as openwrt.lan. The page is plain HTTP, like LuCI, and
# the default firewall keeps port 9527 closed on WAN. To keep the dashboard on
# the router only, change listen to '127.0.0.1:9527' and reach it with
# ssh -L 9527:127.0.0.1:9527 root@<router>.
#
# The first visit creates the administrator. Credentials are stored under
# data_dir in state/honk.db, not in this file.

global {
    wan_interface: auto
    lan_interface: br-lan
    # The upstream default is info; warning keeps the syslog volume low on a
    # 200 MB device without hiding startup failures.
    log_level: warning
    dial_mode: domain++
    # honk sets net.ipv4.ip_forward, the per-interface rp_filter and the
    # accept_local / route_localnet switches itself. This is a dual-port router,
    # not a single-arm gateway, so the documented single-arm sysctls do not apply.
    auto_config_kernel_parameter: true
    data_dir: '/etc/honk/data'
    # Empty: log to stdout, which procd forwards to syslog/logread.
    log_file: ''
    tcp_check_url: 'https://www.gstatic.com/generate_204'
    tcp_check_http_method: HEAD
    check_interval: 300s
    bootstrap_resolver: '1.1.1.1:53'
    # NFQUEUE 320 exists to hold ambiguous LAN UDP first packets. On this
    # kernel it starves dnsmasq: with it enabled every DNS query that has to go
    # out through the WAN stalls (verified on 6.12.112, beta.6), so the whole
    # LAN loses name resolution. honk keeps working without it.
    nfqueue_enable: false
}

dns {
    upstream {
        # dnsmasq on the router; honk sends its own DNS lookups there.
        local: 'udp://127.0.0.1:53'
    }
    routing {
        request {
            fallback: local
        }
        response {
            fallback: local
        }
    }
}

routing {
    # Everything is direct until nodes and rules are added in doona. A direct
    # verdict returns the packet to the kernel, so NSS/ECM and the PPE flowtable
    # keep accelerating forwarded traffic exactly as before.
    fallback: direct
}

experimental {
    # No clash_api block: doona talks to the native API below, and the Clash
    # API would only serve a separate dashboard while costing a listener.
    native_api {
        enabled: true
        listen: '0.0.0.0:9527'
        password_auth: true
        config_write: true
        ui: 'embedded'
    }
    cache_file {
        enabled: true
    }
}
